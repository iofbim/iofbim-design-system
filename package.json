{
  "name": "@ruornil/design-system",
  "version": "0.1.0",
  "description": "IoFBIM brand tokens and Tailwind preset",
  "license": "MIT",
  "private": false,
  "type": "module",
  "files": [
    "tokens.css",
    "tailwind-preset",
    "dist"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tailwind-preset": "./tailwind-preset/index.cjs",
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruornil/iofbim-design-system.git"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "scripts": {
    "prepare": "npm run build || true",
    "build": "tsup",
    "lint": "tsc"
  },
  "devDependencies": {
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  }
}